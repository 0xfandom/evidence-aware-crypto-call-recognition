# Only needed for the LLM backend (`--backend llm` / `--backend hybrid`).
# The default `rules` backend runs fully offline and needs nothing here.
#
# Set ONE of these. See README "Using Claude (optional)" for how to get each.
CLAUDE_CODE_OAUTH_TOKEN=
ANTHROPIC_API_KEY=

# Optional overrides
EACR_MODEL=claude-haiku-5-5
EACR_MAX_BUDGET_USD_PER_POST=0.05
EACR_RUN_BUDGET_USD=2.00
