{"case_id": "dev-f3676f5f2b", "synthetic": true, "available_at_utc": "2025-05-15T12:10:00Z", "primary": {"source_id": "sim_post_c52154dc01efp", "author_id": "sim_author_0078536ed66b", "published_at_utc": "2025-05-15T12:00:00Z", "text": "Covered the $ZANDOR short this afternoon at 0.82. A clean result for a two week trade.", "text_sha256": "db360ef944c859aaca9ab58d2412b41a8d2c93c5fcf2ea3afcbf62155ba731eb", "capture_scope": "FULL_TEXT"}, "context": [], "unavailable_context": [], "asset_identity_evidence": [], "evidence_catalogue": [{"evidence_id": "ev_6bc48ab43a2a914a8c7684a3", "source_id": "sim_post_c52154dc01efp", "start_utf16": 0, "end_utf16": 86}]}
