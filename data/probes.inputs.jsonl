{"case_id": "dev-8dc26c23e1", "synthetic": true, "available_at_utc": "2025-05-04T12:10:00Z", "primary": {"source_id": "sim_post_3122f016766dp", "author_id": "sim_author_17d855687ca0", "published_at_utc": "2025-05-04T12:00:00Z", "text": "Of everything on my watchlist, $STRAVEL is the one I would put fresh capital into today. The unlock schedule is light and the price has reset.", "text_sha256": "f09911ea5cb5df5a96b87763cc2eba3050863230cb83c272446b578a9753471d", "capture_scope": "FULL_TEXT"}, "context": [], "unavailable_context": [], "asset_identity_evidence": [], "evidence_catalogue": [{"evidence_id": "ev_e7be42a2d69fc4413d072892", "source_id": "sim_post_3122f016766dp", "start_utf16": 0, "end_utf16": 142}]}
